# Copy this file to .env.local and fill in the values. (.env.local is not committed)
# Setup guide: docs/AUTH_SETUP.md

# Google OAuth client ID (Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=

# Naver Login client ID / callback URL (Naver Developers)
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CALLBACK_URL=http://localhost:3000/

# (optional) fix "today" for demos: YYYY-MM-DD. Leave empty for the real date
VITE_FIXED_TODAY=

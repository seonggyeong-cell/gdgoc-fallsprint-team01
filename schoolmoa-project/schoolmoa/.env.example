# Copy this file to .env.local and fill in the values. (.env.local is not committed)
# Setup guide: docs/AUTH_SETUP.md

# Supabase (Project Settings > API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# ↓ 서버 함수 전용 (VITE_ 붙이지 않기, Vercel 환경변수에만 등록, 프론트에 절대 노출 금지)
# SUPABASE_SECRET_KEY=

# Google OAuth client ID (Google Cloud Console > Credentials)
VITE_GOOGLE_CLIENT_ID=

# Naver Login client ID / callback URL (Naver Developers)
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CALLBACK_URL=http://localhost:3000/

# Kakao Login javascript key
VITE_KAKAO_JAVASCRIPT_KEY=

# (optional) fix "today" for demos: YYYY-MM-DD. Leave empty for the real date
VITE_FIXED_TODAY=

# ───────── AI 맞춤 추천 (서버 함수 api/recommend.ts 전용 — VITE_ 붙이지 않기, Vercel 환경변수에 등록) ─────────
# 설정 방법: docs/AI_RECOMMEND_SETUP.md
# SUPABASE_SECRET_KEY 는 위 항목 사용 / SUPABASE_URL 이 없으면 VITE_SUPABASE_URL 을 대신 씀
# GEMINI_API_KEY=                 # 기본: Gemini 무료 등급 (Google AI Studio 에서 발급, 결제 등록 불필요)
# LLM_PROVIDER=google             # google | anthropic | openai (다른 회사로 바꿀 때만)
# LLM_MODEL=                      # 비우면 기본값 (gemini-3.5-flash-lite / claude-haiku-5-5 / gpt-5-nano)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_DAILY_LIMIT=3                # 사용자당 하루 AI 추천 호출 횟수
